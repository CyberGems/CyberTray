{
  "name": "cyber-tray",
  "private": true,
  "version": "1.9.0",
  "author": "CyberGems",
  "license": "GPL-3.0-only",
  "homepage": "https://cybergems.org",
  "description": "Your favorite apps, files and links one gesture away, without a crowded taskbar.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "build:electron": "npm run build:store-launcher && vite build && electron-builder",
    "build:store-launcher": "node scripts/build-store-launcher.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "installer-graphics": "node scripts/generate-installer-graphics.mjs"
  },
  "build": {
    "artifactBuildStarted": "./scripts/fix-nsis-process-close.mjs",
    "appId": "com.cybertray.app",
    "productName": "CyberTray",
    "copyright": "Copyright © 2026 CyberGems",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "electron/launch-store-app.exe",
        "to": "launch-store-app.exe"
      }
    ],
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}",
    "unpackDirName": "CyberTray-portable",
    "requestExecutionLevel": "user"
  },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerSidebar": "public/installerSidebar.bmp",
      "uninstallerSidebar": "public/installerSidebar.bmp",
      "installerHeaderIcon": "public/icon.ico",
      "include": "electron/installer.nsh",
      "createDesktopShortcut": "always",
      "runAfterFinish": true,
      "perMachine": true,
      "installerLanguages": [
        "en",
        "es"
      ],
      "multiLanguageInstaller": true,
      "shortcutName": "CyberTray"
    },
    "publish": {
      "provider": "github",
      "owner": "CyberGems",
      "repo": "CyberTray"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^3.2.7"
  }
}
