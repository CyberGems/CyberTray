{
  "name": "cyber-tray",
  "private": true,
  "version": "1.6.0",
  "author": "CyberGems",
  "license": "GPL-3.0-only",
  "description": "CyberTray: a Windows system tray launcher by CyberGems.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "build:electron": "npm run build:store-launcher && vite build && electron-builder",
    "build:store-launcher": "node scripts/build-store-launcher.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "installer-graphics": "node scripts/generate-installer-graphics.mjs"
  },
  "build": {
    "appId": "com.cybertray.app",
    "productName": "CyberTray",
    "copyright": "Copyright © 2026 CyberGems",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "electron/launch-store-app.exe",
        "to": "launch-store-app.exe"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerSidebar": "public/installerSidebar.bmp",
      "uninstallerSidebar": "public/installerSidebar.bmp",
      "installerHeaderIcon": "public/icon.ico",
      "include": "electron/installer.nsh",
      "createDesktopShortcut": "always",
      "runAfterFinish": true,
      "perMachine": true,
      "installerLanguages": [
        "en",
        "es"
      ],
      "multiLanguageInstaller": true,
      "shortcutName": "CyberTray"
    },
    "publish": {
      "provider": "github",
      "owner": "CyberGems",
      "repo": "CyberTray"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.13.24",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^30.1.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^3.2.7"
  }
}
